<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="28dp"
    android:paddingTop="72dp"
    android:paddingBottom="36dp"
    android:gravity="center_horizontal">

    <TextView
        android:id="@+id/kindText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="주간 알람"
        android:textColor="@color/alarm_accent"
        android:textSize="20sp"
        android:letterSpacing="0.06"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/dateText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        tools:text="11/24(화)"
        android:textColor="@color/alarm_secondary_text"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/timeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        tools:text="05:45"
        android:textColor="@color/alarm_text"
        android:textSize="76sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/alarm_subtitle"
        android:textColor="@color/alarm_secondary_text"
        android:textSize="16sp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/snoozeButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/alarm_snooze"
        android:textSize="17sp"
        android:textColor="@color/alarm_text"
        app:backgroundTint="@color/alarm_snooze_bg"
        app:strokeColor="@color/alarm_snooze_stroke"
        app:strokeWidth="1dp"
        app:cornerRadius="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/dismissButton"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="@string/alarm_dismiss"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/alarm_dismiss_text"
        app:backgroundTint="@color/alarm_dismiss_bg"
        app:cornerRadius="18dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/alarm_snooze_note"
        android:textColor="@color/alarm_note_text"
        android:textSize="13sp" />
</LinearLayout>
